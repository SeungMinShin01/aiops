# 디스코드 연동 (docs/discord-setup.md). 값은 이 파일이 아니라 복사본 .env에만 넣는다. .env는 커밋 금지
AIOPS_DISCORD_BOT_TOKEN=
AIOPS_DISCORD_GUILD_ID=
AIOPS_DISCORD_CLIENT_ID=
AIOPS_DISCORD_CLIENT_SECRET=
AIOPS_DISCORD_REDIRECT_URI=http://localhost:8080/api/discord/callback
# 디스코드 연결 OAuth state 서명 키 (AI-93). 아무 긴 임의 문자열
AIOPS_STATE_SECRET=
