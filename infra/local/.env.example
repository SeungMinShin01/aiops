# 로컬 실행용 환경변수 목록. 이 파일을 복사해 같은 폴더에 .env 를 만들고 값을 넣는다.
#   cp infra/local/.env.example infra/local/.env
# ./gradlew :server:bootRun, ./gradlew :sample-app:bootRun 이 .env 를 자동으로 읽는다 (gradle/dotenv.gradle).
# .env 는 커밋 금지 (.gitignore). 커밋하는 건 이 .env.example 뿐. 여기에는 진짜 값을 적지 않는다.
# 빈 값(KEY=)으로 두면 그 기능은 건너뛰거나 기본값으로 동작한다.

# ---- sample-app ----
# 샘플 앱이 서버로 보낼 때 쓰는 키. 로컬 시드 키(운영 키 아님)
AIOPS_KEY=aiops_l_local-dev-key-0001

# ---- server: LLM (AI-54) ----
# OpenAI 호환 chat API 키. 비어 있으면 가짜 응답(FakeLlmClient)으로 동작
AIOPS_LLM_API_KEY=
# 비워 두면 기본값(Gemini 호환 주소, gemini-3.5-flash-lite)
AIOPS_LLM_BASE_URL=
AIOPS_LLM_MODEL=

# ---- server: GitHub 로그인 (AI-78) ----
# OAuth 앱 콜백: http://localhost:8080/login/oauth2/code/github
AIOPS_GITHUB_CLIENT_ID=
AIOPS_GITHUB_CLIENT_SECRET=
# 관리자 GitHub id 목록, 쉼표 구분 숫자 (AI-81). 비어 있으면 관리자 없음
AIOPS_ADMIN_GITHUB_IDS=

# ---- server: 디스코드 (docs/discord-setup.md) ----
AIOPS_DISCORD_BOT_TOKEN=
AIOPS_DISCORD_GUILD_ID=
AIOPS_DISCORD_CLIENT_ID=
AIOPS_DISCORD_CLIENT_SECRET=
AIOPS_DISCORD_REDIRECT_URI=http://localhost:8080/api/discord/callback
# 디스코드 연결 OAuth state 서명 키 (AI-93). 아무 긴 임의 문자열
AIOPS_STATE_SECRET=
# 콘솔 주소 (디스코드 연결 후 돌아갈 곳, AI-93). 비우면 같은 도메인 상대 경로
AIOPS_CONSOLE_BASE_URL=