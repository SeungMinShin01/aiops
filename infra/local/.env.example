# 디스코드 연동 (docs/discord-setup.md). 값은 이 파일이 아니라 복사본 .env에만 넣는다. .env는 커밋 금지
AIOPS_DISCORD_BOT_TOKEN=
AIOPS_DISCORD_GUILD_ID=
AIOPS_DISCORD_CLIENT_ID=
AIOPS_DISCORD_CLIENT_SECRET=
AIOPS_DISCORD_REDIRECT_URI=http://localhost:8080/api/discord/callback
# 디스코드 연결 OAuth state 서명 키 (AI-93). 아무 긴 임의 문자열
AIOPS_STATE_SECRET=
# 콘솔 주소 (디스코드 연결 후 돌아갈 곳, AI-93). 비우면 같은 도메인 상대 경로
AIOPS_CONSOLE_BASE_URL=

# GitHub 로그인 OAuth 앱 (AI-78). 콜백: http://localhost:8080/login/oauth2/code/github
AIOPS_GITHUB_CLIENT_ID=
AIOPS_GITHUB_CLIENT_SECRET=

# 관리자 GitHub id 목록, 쉼표 구분 숫자 (AI-81). 비어 있으면 관리자 없음
AIOPS_ADMIN_GITHUB_IDS=

# LLM (AI-54). OpenAI 호환 chat API. 키가 비어 있으면 가짜 응답(FakeLlmClient)으로 동작
AIOPS_LLM_API_KEY=
# 기본값과 다를 때만 주석을 풀고 넣는다 (빈 값으로 두면 기본값이 아니라 빈 값이 된다)
# AIOPS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AIOPS_LLM_MODEL=gemini-3.8-flash